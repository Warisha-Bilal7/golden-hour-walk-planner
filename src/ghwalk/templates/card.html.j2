<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Golden Hour Walk</title>
  <style>
    @page { size: A4; margin: 14mm; }
    body { font-family: Georgia, "Times New Roman", serif; color: #2b2116;
           background: #fbf6ee; margin: 0; padding: 18px; }
    .card { max-width: 760px; margin: 0 auto; background: #fffdf8;
            border: 1px solid #e8ddc8; border-radius: 14px; padding: 30px 34px;
            box-shadow: 0 6px 24px rgba(120, 90, 40, 0.12); }
    h1 { font-size: 32px; margin: 0 0 4px; letter-spacing: 0.5px; }
    .sub { color: #8a7452; margin: 0 0 20px; font-size: 15px; }
    .facts { display: flex; flex-wrap: wrap; gap: 14px 30px; margin: 0 0 20px;
             padding: 14px 0; border-top: 1px solid #efe5d2; border-bottom: 1px solid #efe5d2; }
    .fact b { display: block; font-size: 12px; text-transform: uppercase;
              letter-spacing: 1px; color: #a08a68; }
    .fact span { font-size: 19px; }
    .lead { font-size: 19px; line-height: 1.55; margin: 0 0 18px; }
    .mapwrap { margin: 18px 0; }
    .mapwrap img { width: 100%; height: auto; border-radius: 10px;
                   border: 1px solid #e8ddc8; display: block; }
    .foot { margin-top: 16px; font-size: 12px; color: #a08a68; }
    @media print { body { background: #fff; padding: 0; } .card { box-shadow: none;
                   border: none; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="card">
    <h1>Golden Hour Walk</h1>
    <p class="sub">A short loop through green space, ending in low light.</p>
    <div class="facts">
      <div class="fact"><b>Distance</b><span>{{ "%.2f"|format(km) }} km</span></div>
      <div class="fact"><b>Duration</b><span>~{{ minutes }} min</span></div>
      <div class="fact"><b>Green</b><span>{{ "%.0f"|format(green_pct * 100) }}%</span></div>
      <div class="fact"><b>Sunset</b><span>{{ sunset }}</span></div>
      <div class="fact"><b>Leave by</b><span>{{ walk_start }}</span></div>
      <div class="fact"><b>Weather</b>
        <span>{% if weather.temp_c is not none %}{{ weather.temp_c }}&deg;C
          {% if weather.precip_prob is not none %}&middot; {{ weather.precip_prob }}% rain
          {% endif %}{% if weather.wind_kmh is not none %}&middot; {{ weather.wind_kmh }} km/h{% endif %}
          {% else %}unavailable{% endif %}</span></div>
    </div>
    <p class="lead">{{ card_text }}</p>
    <div class="mapwrap">
      {% if map_data_uri %}<img src="{{ map_data_uri }}" alt="route map">
      {% else %}<div>route map unavailable</div>{% endif %}
    </div>
    {% if used_fallback %}<p class="foot">Card written from the template (no model).</p>{% endif %}
    <p class="foot">Generated locally by ghwalk. Print me and head outside.</p>
  </div>
</body>
</html>